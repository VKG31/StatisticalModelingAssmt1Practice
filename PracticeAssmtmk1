#============QUESTION 1==========================
#we are looking for strong likes BJ or NF in UK and in scotland
#then look for strong dis sturgeon strong like NF
Q1_df <- bes_df %>%
dplyr::select(gor,likeJohnson,likeFarage,likeSturgeon) %>%
filter(
    !is.na(likeJohnson), likeJohnson != 9999,
    !is.na(likeFarage), likeFarage != 9999
  ) 
Q1_Cases <- nrow(Q1_df)
Pct_Likes_Farageson <- Q1_df %>%
  filter(
    likeJohnson == 10 | likeFarage == 10
  ) %>%
  nrow() / nrow(Q1_df)
Pct_Likes_Farageson #11.57735
Scot_df <- bes_df %>%
  filter(
    !is.na(gor), gor == 11,
    !is.na(likeSturgeon), likeSturgeon != 9999,
    !is.na(likeFarage), likeFarage != 9999
  )
Scot_cases <- nrow(Scot_df)
Scot_Farageon_Pct <- Scot_df %>%
  filter(
    likeSturgeon == 0, likeFarage == 10
  ) %>%
  nrow() / nrow(Scot_df)
Q1_gt <- data.frame(
  Group = c("UK Likes Farage or Johnson ( rating of 10)", 
  "Scotland dislike Sturgeon (0) and like Farage (10)"
  ),
  Percentage = c(Pct_Likes_Farageson, Scot_Farageon_Pct),
  Valid_Cases = c(Q1_Cases, Scot_cases)
  )%>%
  gt() %>%
  fmt_percent(Percentage,decimals = 4) %>%
  fmt_number(Valid_Cases, use_seps = TRUE, decimals = 0) %>%
  tab_header(title = "Q1 Answers", subtitle = "Rounded to 4 Decimal Places")

