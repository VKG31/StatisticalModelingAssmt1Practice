Q6 <- bes_df %>%
  dplyr::select(age, gor, satDemUK)%>%
  filter(satDemUK != 9999, !is.na(satDemUK))
Q6_20to30 <- Q6%>%
  filter(
    age >= 20, age <= 30
  ) %>%
  summarise(
    pct_dissatisfied = mean(satDemUK == 1, na.rm = TRUE) * 100,
    n = n()
  )
# 22.6288% very dissatisfied, with n = 3531
Q6_20to30_gor <- Q6 %>%
filter(
  age >= 20, age <= 30
) %>%
group_by(gor) %>%
summarize(
  pct_dissatisfied = mean(satDemUK == 1, na.rm = FALSE) * 100,
  n = n()
)
## highest in scotland but there are relatively few responses
Q6_60plus <- Q6%>%
  filter(
    age > 60
  ) %>%
  summarise(
    pct_dissatisfied = mean(satDemUK == 1, na.rm = TRUE) * 100,
    n = n()
  )
#17.37723% very dissatisfied with n=11118
Q6_60plus_gor <- Q6 %>%
group_by(gor) %>%
filter(
